# 生产编排环境变量模板
#
#   cp .env.example .env
#   # 改掉所有 CHANGE_ME，再 docker compose --env-file .env up -d --build
#
# 三个密码/密钥生成方式：
#   openssl rand -base64 48        （JWT_SECRET / 回调令牌，≥32 字节）
#   openssl rand -hex 16           （数据库密码）

# ============================================================
# 镜像tag：**不要用 latest**，按版本或 git sha 打，回滚就靠它
# ============================================================
TAG=1.0.0

# ============================================================
# 对外端口（只开这一个；8080/8010/3306 不对外）
# ============================================================
HTTP_PORT=80

# ============================================================
# 数据库
# ============================================================
DB_NAME=rs_platform
DB_ROOT_PASSWORD=CHANGE_ME_root_password
# 业务账号：后端用它连库，不用 root
DB_USER=rs_app
DB_PASSWORD=CHANGE_ME_app_password

# ============================================================
# 应用密钥（上线必须全部替换，默认值在仓库里是公开的）
# ============================================================
# JWT 签名密钥，HS256 要求 ≥32 字节
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_48
# Java 与 inference 的回调共享密钥，两侧必须完全一致
INFERENCE_CALLBACK_TOKEN=CHANGE_ME_use_openssl_rand_base64_48

# ============================================================
# 前端构建期变量（Vite 会把它们编译进 bundle）
# ------------------------------------------------------------
# 注意：这两个值**改完必须重新 build 前端镜像**，改 .env 后重启容器无效。
# 天地图 tk 缺失时三维大屏底图是空的。
# ============================================================
VITE_TIANDITU_TOKEN=
VITE_CESIUM_TOKEN=

# 构建时的 npm 源（内网有私有源就改成私有源地址）
NPM_REGISTRY=https://registry.npmmirror.com

# ============================================================
# 日志级别（DEBUG / INFO / WARNING / ERROR）
# ============================================================
INFERENCE_LOG_LEVEL=INFO
