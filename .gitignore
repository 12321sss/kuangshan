# ============================================================
# 依赖目录（体积大、平台相关、可由包管理器重建）
# ============================================================
node_modules/
.venv/
venv/

# ============================================================
# 构建产物与缓存（可重新生成）
# ============================================================
dist/
dist-ssr/
build/
target/
out/
*.jar
*.class
*.tsbuildinfo
__pycache__/
*.py[cod]
# Python 测试/检查工具缓存（pytest 与 ruff 都会在项目下建目录）
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 影像瓦片缓存：首次运行自动重新下载（约 70MB）
.cache/
inference/.cache/

# ============================================================
# 数据目录（影像/结果体量大，不入库）
# ============================================================
data/
inference/data/

# 数据库文件
*.db
*.db-journal
*.sqlite
*.sqlite3

# ============================================================
# 环境变量与密钥（只允许提交 example 模板）
# ============================================================
.env
.env.local
.env.*.local
**/.env
!**/.env.example
!**/.env.sample
*.key
*.pem
*.p12
*.pfx

# ============================================================
# 运行时产物
# ============================================================
logs/
*.log
npm-debug.log*
yarn-error.log*

# ============================================================
# IDE 与系统
# ============================================================
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 临时文件
# ============================================================
*.tmp
*.bak
*.orig
~$*.docx
~$*.xlsx

# ============================================================
# 交付产物与临时增量包（不入库，避免仓库膨胀）
# ============================================================
遥感提取功能-增量包-*/
*.zip
*.docx
!docs/**/*.docx
# ============================================================
# 调研/演示产物（体积大或含客户信息，不入库）
# ============================================================
# AI 调研工具产物（含浏览器抓取的网页与脚本，约 2MB）
.aie_research/

# 演示数据包缓存（预下载的解译结果，可由 generateDemoPackage 重新生成）
inference/demo_data/

# 客户交付文档（合同/报告类，不入代码仓库）
*.docx
*.pdf

# 拉取前备份目录（本地保留，不入库）
_backup_before_pull/

# 本地临时验证文件（边界导入测试用，不入库）
inference/_t/

# 客户提供的边界原始数据（含坐标，不入库）
矿山边界/

# 客户原始影像（体积大且含坐标，不入库）
影像/
