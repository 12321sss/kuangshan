# ============================================
# 基础设施与业务配置模板（占位值，禁止提交真实密钥）
# 复制为 .env 后按环境填值，.env 已加入 .gitignore
# ============================================

# ---- PostgreSQL + PostGIS ----
POSTGRES_USER=rsapp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rs_platform
POSTGRES_PORT=5432

# ---- MinIO 对象存储（影像/结果/模型文件）----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_IMAGES=rs-images
MINIO_BUCKET_RESULTS=rs-results

# ---- Redis（会话/缓存/任务队列）----
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- EMQX（IoT 接入，demo 阶段单机）----
EMQX_MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=changeme

# ---- Java 业务服务 ----
BACKEND_PORT=8080
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=30
# 解译服务地址
INFERENCE_BASE_URL=http://localhost:8000

# ---- FastAPI 解译服务 ----
# 解译服务端口
INFERENCE_PORT=8000
JAVA_CALLBACK_URL=http://localhost:8080/api/callback/task-complete
# 回调共享密钥（需与后端 INFERENCE_CALLBACK_TOKEN 一致）
INFERENCE_CALLBACK_TOKEN=rs-demo-inference-token-2026
# 解译 Worker 使用的数据根目录（影像/结果落盘处）
INFERENCE_DATA_DIR=./data

# ---- 前端 ----
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080/ws
