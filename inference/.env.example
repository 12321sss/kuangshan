# 解译服务环境变量模板
#
# 用法：复制为 inference/.env 后按需修改（.env 已在 .gitignore 里，不会入库）。
# 说明：本服务当前不自动加载 .env 文件，实际部署时通过环境变量或启动脚本注入。
#       想本地生效，可在 PowerShell 里 setx INFERENCE_CALLBACK_TOKEN "..." 后重开终端。

# ---------------------------------------------------------------------------
# 回调鉴权
# ---------------------------------------------------------------------------
# 解译完成后回调 Java 时带的 X-Inference-Token，必须与 Java 侧
# INFERENCE_CALLBACK_TOKEN 完全一致，否则后端返回 401。
# 安全提示：不带此头时回调端点可被任意伪造写入假数据，正式环境务必改成随机串。
INFERENCE_CALLBACK_TOKEN=rs-demo-inference-token-2026

# 回调超时（秒）。回调只是写库，30 秒足够；解译本身耗时不影响这里。
INFERENCE_CALLBACK_TIMEOUT=30

# ---------------------------------------------------------------------------
# 目录
# ---------------------------------------------------------------------------
# 离线演示数据包（一键预下载结果）落盘目录，默认 inference/demo_data
# INFERENCE_DEMO_DIR=E:/LYY/赣锋锂电遥感解译平台/inference/demo_data

# 在线 Sentinel-2 tile 与 DEM 瓦片缓存目录，默认 inference/.cache
# 演示机 C 盘紧张时指到 E 盘，可省下几百 MB
# INFERENCE_CACHE_DIR=E:/rs-cache

# ---------------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------------
# DEBUG / INFO / WARNING / ERROR，默认 INFO
INFERENCE_LOG_LEVEL=INFO
